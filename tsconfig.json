{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "scripts/seed",
    "tests/data/seed.test.ts",
    "tests/seed-bundle.test.ts",
    "tests/e2e/test-accounts.spec.ts",
    "vite.config.ts"
  ]
}
