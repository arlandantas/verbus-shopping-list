{
  "name": "verbus-shopping-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "dev:local": "node --disable-warning=ExperimentalWarning scripts/dev-local.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --project rules\"",
    "test:data": "firebase emulators:exec --only auth,firestore \"vitest run --project data\"",
    "audit:ci": "pnpm audit --prod --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:rules && pnpm test:data",
    "test:e2e": "firebase emulators:exec --only auth,firestore \"playwright test\""
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@material-symbols/svg-400": "^0.48.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "^7.4.1"
  }
}
