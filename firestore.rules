rules_version = '2';

// Deny by default (ADR-0003).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMember(familyId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    function isMemberAfter(familyId) {
      return isSignedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // One family per user (S-014): profile goes null -> familyId, in the same batch.
    function profileJoins(familyId) {
      return get(userRef(request.auth.uid)).data.familyId == null
        && getAfter(userRef(request.auth.uid)).data.familyId == familyId;
    }

    function validUser(data) {
      return data.keys().hasOnly(['displayName', 'email', 'familyId', 'createdAt'])
        && data.keys().hasAll(['displayName', 'email', 'familyId', 'createdAt'])
        && data.displayName is string
        && data.email is string
        && data.createdAt is timestamp
        && (data.familyId == null
          || (data.familyId is string && isMemberAfter(data.familyId)));
    }

    // 8 chars from 23456789ABCDEFGHJKMNPQRSTUVWXYZ (ADR-0003).
    function validCode(code) {
      return code is string && code.matches('^[2-9A-HJKMNP-Z]{8}$');
    }

    function validFamilyCreate(data, familyId) {
      return data.keys().hasOnly(['name', 'members', 'ownerId', 'inviteCode', 'createdAt'])
        && data.keys().hasAll(['name', 'members', 'ownerId', 'inviteCode', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 60
        && data.members is list
        && data.members == [request.auth.uid]
        && data.ownerId == request.auth.uid
        && validCode(data.inviteCode)
        && getAfter(/databases/$(database)/documents/invites/$(data.inviteCode)).data.familyId == familyId
        && getAfter(/databases/$(database)/documents/invites/$(data.inviteCode)).data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && profileJoins(familyId);
    }

    function validJoin(familyId) {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && !(request.auth.uid in before.members)
        && after.diff(before).affectedKeys().hasOnly(['members', 'joinCode'])
        && after.members == before.members.concat([request.auth.uid])
        && after.members.size() <= 10
        && validCode(after.joinCode)
        && get(/databases/$(database)/documents/invites/$(after.joinCode)).data.familyId == familyId
        && profileJoins(familyId);
    }

    function validInvite(data, code) {
      return data.keys().hasOnly(['familyId', 'familyName', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['familyId', 'familyName', 'createdBy', 'createdAt'])
        && validCode(code)
        && data.familyId is string
        && data.familyName is string
        && data.familyName.size() >= 1 && data.familyName.size() <= 60
        && data.familyName == getAfter(/databases/$(database)/documents/families/$(data.familyId)).data.name
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && isMemberAfter(data.familyId);
    }

    // Shared field validators (ADR-0008). UNITS must equal src/domain/units.ts.
    function validNameKey(v) {
      return v is string && v.size() >= 1 && v.size() <= 80
        && v.matches('^[a-z0-9]+( [a-z0-9]+)*$');
    }

    function validQuantity(v) {
      return v is number && v > 0 && v <= 9999;
    }

    function validUnit(v) {
      return v in ['un', 'kg', 'g', 'l', 'ml', 'pct', 'cx', 'dz'];
    }

    function validCategoryId(v) {
      return v == null || (v is string && v.size() >= 1 && v.size() <= 40);
    }

    function validName(v) {
      return v is string && v.size() >= 1 && v.size() <= 80;
    }

    function validItemShape(d) {
      return d.keys().hasOnly(['name', 'nameKey', 'quantity', 'unit', 'note', 'categoryId',
          'recurring', 'status', 'markedBy', 'markedAt', 'priceCents', 'createdBy', 'createdAt'])
        && d.keys().hasAll(['name', 'nameKey', 'quantity', 'unit', 'note', 'categoryId',
          'recurring', 'status', 'markedBy', 'markedAt', 'priceCents', 'createdBy', 'createdAt'])
        && validName(d.name)
        && validNameKey(d.nameKey)
        && validQuantity(d.quantity)
        && validUnit(d.unit)
        && (d.note == null || (d.note is string && d.note.size() <= 120))
        && validCategoryId(d.categoryId)
        && d.recurring is bool
        && d.status in ['pending', 'bought']
        && (d.markedBy == null || d.markedBy is string)
        && (d.markedAt == null || d.markedAt is timestamp)
        && validPriceCents(d.priceCents, 10000000)
        && d.createdBy is string;
    }

    // Catalog entry (ADR-0009/0010): doc id is the nameKey; recurring optional bool.
    function validCatalogEntry(d, id) {
      return d.keys().hasOnly(['name', 'nameKey', 'quantity', 'unit', 'categoryId', 'lastUsedAt', 'recurring'])
        && d.keys().hasAll(['name', 'nameKey', 'quantity', 'unit', 'categoryId', 'lastUsedAt'])
        && (!('recurring' in d) || d.recurring is bool)
        && validName(d.name)
        && validNameKey(id)
        && d.nameKey == id
        && validQuantity(d.quantity)
        && validUnit(d.unit)
        && validCategoryId(d.categoryId)
        && d.lastUsedAt == request.time;
    }

    // Category shape (ADR-0014): exact keys, name 1-40, isDefault bool, order int 0-999.
    function validCategory(d) {
      return d.keys().hasOnly(['name', 'isDefault', 'order'])
        && d.keys().hasAll(['name', 'isDefault', 'order'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 40
        && d.isDefault is bool
        && d.order is int && d.order >= 0 && d.order <= 999;
    }

    // Defaults only appear in the batch that creates the family (family absent before it).
    // User categories cannot take a default id (ADR-0014).
    function validCategoryCreate(d, familyId, categoryId) {
      return isMemberAfter(familyId)
        && validCategory(d)
        && ((d.isDefault == false
            && !(categoryId in ['mercearia', 'hortifruti', 'carnes', 'laticinios', 'limpeza',
              'higiene']))
          || (d.isDefault == true
            && !exists(/databases/$(database)/documents/families/$(familyId))));
    }

    function validMemberProfile(d) {
      return d.keys().hasOnly(['displayName'])
        && d.keys().hasAll(['displayName'])
        && d.displayName is string
        && d.displayName.size() >= 1 && d.displayName.size() <= 60;
    }

    function validItemCreate(d) {
      return validItemShape(d)
        && d.status == 'pending'
        && d.markedBy == null && d.markedAt == null && d.priceCents == null
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    function validItemUpdate(before, after) {
      return validItemShape(after)
        && after.createdBy == before.createdBy
        && after.createdAt == before.createdAt
        && (!after.diff(before).affectedKeys().hasAny(['status', 'markedBy', 'markedAt'])
          || (after.status == 'bought'
            && after.markedBy == request.auth.uid
            && after.markedAt == request.time)
          || (after.status == 'pending' && after.markedBy == null && after.markedAt == null));
    }

    function validCycle(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validMarket(v) {
      return v == null || (v is string && v.size() >= 1 && v.size() <= 60);
    }

    function validPriceCents(v, max) {
      return v == null || (v is int && v >= 0 && v <= max);
    }

    // ADR-0012: create-only purchase (one trip to the market).
    function validPurchase(d) {
      return d.keys().hasOnly(['cycle', 'market', 'itemCount', 'totalCents', 'createdBy', 'purchasedAt'])
        && d.keys().hasAll(['cycle', 'market', 'itemCount', 'totalCents', 'createdBy', 'purchasedAt'])
        && validCycle(d.cycle)
        && validMarket(d.market)
        && d.itemCount is int && d.itemCount >= 1 && d.itemCount <= 200
        && validPriceCents(d.totalCents, 2000000000)
        && d.createdBy == request.auth.uid
        && d.purchasedAt == request.time;
    }

    // ADR-0012: create-only history line, doc id = archived item id.
    function validPurchaseLine(d) {
      return d.keys().hasOnly(['purchaseId', 'cycle', 'name', 'nameKey', 'quantity', 'unit',
          'categoryId', 'categoryName', 'priceCents', 'market', 'markedBy', 'purchasedAt'])
        && d.keys().hasAll(['purchaseId', 'cycle', 'name', 'nameKey', 'quantity', 'unit',
          'categoryId', 'categoryName', 'priceCents', 'market', 'markedBy', 'purchasedAt'])
        && d.purchaseId is string
        && validCycle(d.cycle)
        && validName(d.name)
        && validNameKey(d.nameKey)
        && validQuantity(d.quantity)
        && validUnit(d.unit)
        && validCategoryId(d.categoryId)
        && (d.categoryName == null
          || (d.categoryName is string && d.categoryName.size() >= 1 && d.categoryName.size() <= 40))
        && validPriceCents(d.priceCents, 10000000)
        && validMarket(d.market)
        && (d.markedBy == null || d.markedBy is string)
        && d.purchasedAt == request.time;
    }

    // ADR-0013: create-only month marker; doc id = cycle (YYYY-MM).
    function validCycleMarker(d, id) {
      return d.keys().hasOnly(['openedBy', 'openedAt', 'recurringAdded'])
        && d.keys().hasAll(['openedBy', 'openedAt', 'recurringAdded'])
        && validCycle(id)
        && d.openedBy == request.auth.uid
        && d.openedAt == request.time
        && d.recurringAdded is int && d.recurringAdded >= 0 && d.recurringAdded <= 400;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.familyId == null
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.familyId == null
          || request.resource.data.familyId == resource.data.familyId);
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && validFamilyCreate(request.resource.data, familyId);
      allow update: if validJoin(familyId);
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validItemCreate(request.resource.data);
        allow update: if isMember(familyId)
          && validItemUpdate(resource.data, request.resource.data);
        allow delete: if isMember(familyId);
      }

      match /cycles/{cycleId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validCycleMarker(request.resource.data, cycleId);
        allow update, delete: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validPurchase(request.resource.data);
        allow update, delete: if false;
      }

      match /purchaseLines/{itemId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validPurchaseLine(request.resource.data);
        allow update, delete: if false;
      }

      // Member profile (ADR-0011): readable by the family, writable only by its owner uid.
      match /members/{uid} {
        allow read: if isMember(familyId);
        // isMemberAfter: also valid inside the create/join batch that adds the caller to members.
        allow create, update: if isMemberAfter(familyId) && isOwner(uid)
          && validMemberProfile(request.resource.data);
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isMember(familyId);
        allow create: if validCategoryCreate(request.resource.data, familyId, categoryId);
        allow update: if isMember(familyId)
          && resource.data.isDefault == false
          && validCategory(request.resource.data)
          && request.resource.data.isDefault == false;
        allow delete: if isMember(familyId) && resource.data.isDefault == false;
      }

      match /catalog/{nameKey} {
        allow read: if isMember(familyId);
        allow create, update: if isMember(familyId)
          && validCatalogEntry(request.resource.data, nameKey);
        allow delete: if false;
      }
    }

    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && validInvite(request.resource.data, code);
      allow update: if false;
      allow delete: if isMember(resource.data.familyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
