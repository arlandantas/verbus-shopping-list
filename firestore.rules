rules_version = '2';

// Deny by default (ADR-0003).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMember(familyId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    function isMemberAfter(familyId) {
      return isSignedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // One family per user (S-014): profile goes null -> familyId, in the same batch.
    function profileJoins(familyId) {
      return get(userRef(request.auth.uid)).data.familyId == null
        && getAfter(userRef(request.auth.uid)).data.familyId == familyId;
    }

    function validUser(data) {
      return data.keys().hasOnly(['displayName', 'email', 'familyId', 'createdAt'])
        && data.keys().hasAll(['displayName', 'email', 'familyId', 'createdAt'])
        && data.displayName is string
        && data.email is string
        && data.createdAt is timestamp
        && (data.familyId == null
          || (data.familyId is string && isMemberAfter(data.familyId)));
    }

    // 8 chars from 23456789ABCDEFGHJKMNPQRSTUVWXYZ (ADR-0003).
    function validCode(code) {
      return code is string && code.matches('^[2-9A-HJKMNP-Z]{8}$');
    }

    function validFamilyCreate(data, familyId) {
      return data.keys().hasOnly(['name', 'members', 'ownerId', 'inviteCode', 'createdAt'])
        && data.keys().hasAll(['name', 'members', 'ownerId', 'inviteCode', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 60
        && data.members is list
        && data.members == [request.auth.uid]
        && data.ownerId == request.auth.uid
        && validCode(data.inviteCode)
        && getAfter(/databases/$(database)/documents/invites/$(data.inviteCode)).data.familyId == familyId
        && getAfter(/databases/$(database)/documents/invites/$(data.inviteCode)).data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && profileJoins(familyId);
    }

    function validJoin(familyId) {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && !(request.auth.uid in before.members)
        && after.diff(before).affectedKeys().hasOnly(['members', 'joinCode'])
        && after.members == before.members.concat([request.auth.uid])
        && after.members.size() <= 10
        && validCode(after.joinCode)
        && get(/databases/$(database)/documents/invites/$(after.joinCode)).data.familyId == familyId
        && profileJoins(familyId);
    }

    function validInvite(data, code) {
      return data.keys().hasOnly(['familyId', 'familyName', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['familyId', 'familyName', 'createdBy', 'createdAt'])
        && validCode(code)
        && data.familyId is string
        && data.familyName is string
        && data.familyName.size() >= 1 && data.familyName.size() <= 60
        && data.familyName == getAfter(/databases/$(database)/documents/families/$(data.familyId)).data.name
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && isMemberAfter(data.familyId);
    }

    // Items shape (ADR-0008). UNITS must equal src/domain/units.ts.
    function validItemShape(d) {
      return d.keys().hasOnly(['name', 'nameKey', 'quantity', 'unit', 'note', 'categoryId',
          'recurring', 'status', 'markedBy', 'markedAt', 'priceCents', 'createdBy', 'createdAt'])
        && d.keys().hasAll(['name', 'nameKey', 'quantity', 'unit', 'note', 'categoryId',
          'recurring', 'status', 'markedBy', 'markedAt', 'priceCents', 'createdBy', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.nameKey is string && d.nameKey.size() >= 1 && d.nameKey.size() <= 80
        && d.nameKey.matches('^[a-z0-9]+( [a-z0-9]+)*$')
        && d.quantity is number && d.quantity > 0 && d.quantity <= 9999
        && d.unit in ['un', 'kg', 'g', 'l', 'ml', 'pct', 'cx', 'dz']
        && (d.note == null || (d.note is string && d.note.size() <= 120))
        && (d.categoryId == null
          || (d.categoryId is string && d.categoryId.size() >= 1 && d.categoryId.size() <= 40))
        && d.recurring is bool
        && d.status in ['pending', 'bought']
        && (d.markedBy == null || d.markedBy is string)
        && (d.markedAt == null || d.markedAt is timestamp)
        && (d.priceCents == null
          || (d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 10000000))
        && d.createdBy is string;
    }

    function validItemCreate(d) {
      return validItemShape(d)
        && d.status == 'pending'
        && d.markedBy == null && d.markedAt == null && d.priceCents == null
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    function validItemUpdate(before, after) {
      return validItemShape(after)
        && after.createdBy == before.createdBy
        && after.createdAt == before.createdAt
        && (!after.diff(before).affectedKeys().hasAny(['status', 'markedBy', 'markedAt'])
          || (after.status == 'bought'
            && after.markedBy == request.auth.uid
            && after.markedAt == request.time)
          || (after.status == 'pending' && after.markedBy == null && after.markedAt == null));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.familyId == null
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.familyId == null
          || request.resource.data.familyId == resource.data.familyId);
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && validFamilyCreate(request.resource.data, familyId);
      allow update: if validJoin(familyId);
      allow delete: if false;

      match /items/{itemId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && validItemCreate(request.resource.data);
        allow update: if isMember(familyId)
          && validItemUpdate(resource.data, request.resource.data);
        allow delete: if isMember(familyId);
      }
    }

    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && validInvite(request.resource.data, code);
      allow update: if false;
      allow delete: if isMember(resource.data.familyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
